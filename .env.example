# Copy to .env and fill in. Never commit .env.
# Admin token for starting pipeline runs and rolling back the model from the web page.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change-me
# Key that encrypts the prediction log (logs/predictions.enc).
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Set to true to let a drift or live-error alert start a retraining run by itself (at most once a day).
AUTO_RETRAIN=false
