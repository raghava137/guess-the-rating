flowchart TB
  user([User's browser])
  lichess[("Lichess: monthly dumps<br/>and game export API")]
  dvcstore[("DVC remote<br/>~/dvc-store")]

  subgraph app["Application"]
    direction LR
    frontend["frontend (nginx :8080)<br/>HTML, CSS, JS"]
    backend["backend (FastAPI :8000)<br/>Stockfish pool, drift,<br/>alert webhook, /metrics"]
    model["model (:5001)<br/>mlflow models serve,<br/>follows @champion"]
    frontend -- "REST /api/v1" --> backend
    backend -- "POST /invocations" --> model
  end

  subgraph mlops["Pipeline and model management"]
    direction LR
    pipeline["pipeline (runner :8100)<br/>dvc repro, Ray :8265"]
    mlflow["mlflow (:5050)<br/>tracking + registry"]
    pipeline -- "runs, register, aliases" --> mlflow
  end

  subgraph mon["Monitoring"]
    direction LR
    node["node-exporter :9100"]
    prom["prometheus :9090"]
    am["alertmanager :9093"]
    graf["grafana :3000"]
    node --> prom
    prom -- "alerts" --> am
    graf -- "PromQL" --> prom
  end

  user --> frontend
  backend -- "console" --> pipeline
  backend -- "aliases, rollback" --> mlflow
  model -- "load version" --> mlflow
  pipeline -- "smoke test" --> backend
  pipeline -- "stream month" --> lichess
  backend -- "fetch game" --> lichess
  pipeline -- "dvc push" --> dvcstore
  prom -- "scrape /metrics" --> backend
  prom -- "scrape" --> pipeline
  prom -- "scrape" --> mlflow
  am -- "webhook" --> backend
  frontend -. "embedded panels" .-> graf
