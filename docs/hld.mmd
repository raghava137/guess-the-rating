flowchart TB
  subgraph data[Data engineering]
    A[ingest<br/>stream one month, keep a<br/>rating-stratified blitz sample] --> B[validate<br/>Ray tasks: parse every game,<br/>drop bad / duplicate games]
    B --> C[featurize<br/>Ray actors: Stockfish depth 10,<br/>17 features per player]
  end
  subgraph ml[Modelling]
    C --> D[train<br/>mlflow run: 3 LightGBM models<br/>q0.1 / median / q0.9]
    D --> E[evaluate<br/>held-out players: MAE, coverage,<br/>per band, baselines]
    E --> F{promote gate<br/>coverage 0.75-0.85,<br/>beats baseline and champion}
  end
  F -- pass --> G["@champion moves<br/>model server reloads"]
  G --> H{smoke test<br/>3 real games via backend}
  H -- fail --> R[roll back aliases]
  F -- fail --> K[keep current champion]
  subgraph serve[Serving and monitoring]
    G --> S[backend: same feature code<br/>+ model server]
    S --> M[Prometheus metrics:<br/>latency, errors, PSI drift,<br/>live MAE, component health]
    M --> AL[Alertmanager]
  end
  AL -- "FeatureDrift / LiveErrorHigh<br/>(AUTO_RETRAIN=true, 24 h cooldown)" --> A
